# Скопируйте этот файл в .env (в ту же папку) и впишите свои значения.
# Файл .env в git не попадает.
INVENTREE_URL=https://p2ptd-inventory.online
INVENTREE_TOKEN=inv-вставьте-сюда-токен

# --- Telegram-бот (docs/BOT.md)
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram ID администраторов через запятую: видят журнал, получают уведомления об ошибках
BOT_ADMIN_IDS=
# Telegram ID сотрудников через запятую; пусто = бот отвечает всем, но без входа ничего не делает
BOT_ALLOWED_TELEGRAM_IDS=

# Распознавание: claude | olegovic | local, или цепочка: olegovic,claude
#   olegovic — модель, которую уже запускает olegovic-llm на этом ПК: адрес, модель (vision, иначе smart)
#              и think берутся из ~/.config/olegovic/config.toml (другой путь: OLEGOVIC_CONFIG)
#   local    — любой OpenAI-совместимый сервер с vision-моделью, адрес и модель ниже
#   claude   — Claude API, нужен ANTHROPIC_API_KEY
BOT_RECOGNIZER=olegovic
# ANTHROPIC_API_KEY=
# Для local (для olegovic — чтобы переопределить его настройки):
# LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=qwen3.6-35b-a3b
# LOCAL_LLM_API_KEY=
# размышления модели: пусто — выключены (если в [llm.think] olegovic для модели не задано иное),
# true/false для Qwen, low/medium/high для gpt-oss
# LOCAL_LLM_THINK=
# секунд на ответ; llama-swap может сначала загружать модель с диска
# LOCAL_LLM_TIMEOUT=300

# Необязательно:
# папка для базы пользователей, журнала и логов (bot_data/logs/bot.log)
# BOT_DATA_DIR=bot_data
# DEBUG — в лог пишется ещё и каждый запрос к InvenTree с временем
# BOT_LOG_LEVEL=INFO
# BOT_CLAUDE_MODEL=claude-opus-5-5
# low быстрее; medium или high, если модель ошибается на ваших фото
# BOT_CLAUDE_EFFORT=low
# BOT_SERIAL_PREFIX=P2PTD
# BOT_SERIAL_DIGITS=4
# шаблон этикетки в InvenTree (install_label_template.py); пусто — этикетку рисует бот
# BOT_LABEL_TEMPLATE=P2PTD 62x29

# --- Ночной поиск мануалов и фото (python -m scraper, docs/SCRAPER.md)
# Работает от имени пользователя INVENTREE_TOKEN: нужны Parts: View/Change, Purchase Orders: View.
# Отчёт приходит администраторам (BOT_ADMIN_IDS) через TELEGRAM_BOT_TOKEN.
# SCRAPER_LIMIT=20
# SCRAPER_RETRY_DAYS=30
# SCRAPER_MANUALS=true
# SCRAPER_PHOTOS=true
# false — мануалы только из папки olegovic-llm, без своего поиска
# SCRAPER_MANUAL_SEARCH=true
# file — PDF во вложения InvenTree, link — только ссылка на сайт производителя
# SCRAPER_MANUAL_MODE=file
# папка мануалов olegovic-llm; по умолчанию берётся из ~/.config/olegovic/config.toml; пусто — не использовать
# SCRAPER_OLEGOVIC_MANUALS=
# проверка находок моделью: olegovic (модель из конфига olegovic-llm), local (LOCAL_LLM_URL/MODEL), off
# SCRAPER_VERIFY=olegovic
# поиск: ddgs (DuckDuckGo, без ключа), brave (BRAVE_API_KEY), tavily (TAVILY_API_KEY)
# или цепочка: следующий берётся, если предыдущий ответил ошибкой (кончились кредиты, лимит).
# По умолчанию: tavily,ddgs если задан TAVILY_API_KEY; brave,ddgs если BRAVE_API_KEY; иначе ddgs
# SCRAPER_SEARCH=tavily,ddgs
# BRAVE_API_KEY=
# ключ на app.tavily.com, бесплатно 1000 кредитов в месяц
# TAVILY_API_KEY=
# basic — 1 кредит за запрос, advanced — 2 кредита, результаты точнее
# TAVILY_SEARCH_DEPTH=basic
