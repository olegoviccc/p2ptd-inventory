# Ночной поиск мануалов и фото для моделей в InvenTree. Запускается таймером p2ptd-scraper.timer.
[Unit]
Description=p2ptd: мануалы и фото моделей для InvenTree
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/p2ptd-inventory
ExecStart=%h/code/p2ptd-inventory/.venv/bin/python -m scraper --nightly
Nice=10
Environment=PYTHONUNBUFFERED=1
